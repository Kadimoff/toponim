{"id":"somulutepe-yasayis-yeri","qid":"Q4526087","category":"site","type":"site","names":{"az":"Şomulutəpə yaşayış yeri","ru":"Шомутепе","en":"Shomutapa"},"coordinates":[45.45833,41.12444],"coordinatesSource":"wd","region":"qazax-tovuz","regionSource":"wp-az-regions","admin":[{"qid":"Q275744","az":"Ağstafa rayonu","en":"Aghstafa District"}],"firstRecord":null,"period":null,"forms":[],"namedAfter":[],"etymology":[],"summary":{"az":{"text":"Şomutəpə (və ya Şomulutəpə) — Ağstafa rayonu ərazisində qədim yaşayış yeri.","truncated":false,"source":"wp-az"},"ru":{"text":"Шомутепе (азерб. Şomutəpə) — поселение, относящееся к Шомутепинско-Шулаверской культуре эпохи энеолита, расположенное у города Акстафа (на 300 м к северу от шоссе) Акстафинского района Азербайджана.\nВ ходе раскопок в круглоплановых домах поселения было обнаружено несколько фрагментов женских статуэток, изготовленных из кости и глины. Одна из костяных фигурок была вмонтирована в стену прямо над очагом.","truncated":false,"source":"wp-ru"},"en":{"text":"Shomu-tepe (Şomutəpə) is an ancient settlement in the Agstafa District of Azerbaijan. The Neolithic Shulaveri-Shomu culture that formed in the Southern Caucasus is connected with the name of this monument.\nThe settlement is located in the northern suburb of the modern city of Agstafa.","truncated":false,"source":"wp-en"}},"images":[],"sources":[{"id":"wd","kind":"wikidata","title":"Wikidata Q4526087: Shomutapa","publisher":"Wikidata","url":"https://www.wikidata.org/wiki/Q4526087","licence":"CC0 1.0","retrieved":"2026-11-26"},{"id":"wp-az","kind":"wikipedia","lang":"az","title":"Şomutəpə (yaşayış yeri)","publisher":"Vikipediya (azərbaycanca)","url":"https://az.wikipedia.org/w/index.php?title=%C5%9Eomut%C9%99p%C9%99_(ya%C5%9Fay%C4%B1%C5%9F_yeri)&oldid=9178448","pageUrl":"https://az.wikipedia.org/wiki/%C5%9Eomut%C9%99p%C9%99_(ya%C5%9Fay%C4%B1%C5%9F_yeri)","revid":9178448,"revDate":"2026-11-08","licence":"CC BY-SA 4.0","retrieved":"2026-11-26"},{"id":"wp-ru","ki