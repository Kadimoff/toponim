{"id":"celilabad","qid":"Q1020627","category":"city","type":"oikonym","names":{"az":"Cəlilabad","ru":"Джалилабад","en":"Jalilabad"},"coordinates":[48.49583,39.20417],"coordinatesSource":"wd","region":"lenkeran-astara","regionSource":"wp-az-regions","admin":[{"qid":"Q372795","az":"Cəlilabad rayonu","en":"Jalilabad District"}],"firstRecord":null,"period":null,"forms":[{"form":"Астрахан-Базар","lang":"ru","to":1967,"sources":["wd","wp-ru"]},{"form":"Astarxanbazar","lang":"az","to":1967,"sources":["wd"]},{"form":"Хасыллы","lang":"ru","sources":["wp-ru"]}],"namedAfter":[],"etymology":[],"summary":{"az":{"text":"Cəlilabad — Azərbaycan Respublikasının Cəlilabad rayonunun Cəlilabad şəhər inzibati ərazi dairəsində şəhər, Cəlilabad rayonunun inzibati mərkəzi. 1952-ci ildə rayon tabeli şəhər statusu almışdır. Ən çox şəhər əhalisi olan rayonlardan biridir.","truncated":false,"source":"wp-az"},"ru":{"text":"Джалильаба́д (азерб. Cəlilabad) — город и административный центр Джалильабадского района Азербайджана.","truncated":false,"source":"wp-ru"},"en":{"text":"Jalilabad (Azerbaijani: Cəlilabad), also known as Astrakhanka, and Astrakhan-Bazar until 1967, is a city in and the capital of the Jalilabad District of Azerbaijan. The city is named after the Azerbaijani satirist and writer Jalil Mammadguluzadeh (1869-1932).","truncated":false,"source":"wp-en"}},"images":[],"sources":[{"id":"wd","kind":"wikidata","title":"Wikidata Q1020627: Jalilabad","publisher":"Wikidata","url":"https://www.wikidata.org/wiki/Q1020627","licence":"CC0 1.0","retrieved":"2026-11-26"},{"id":"wp-az","kind":"wikipedia","lang":"az","title":"Cəlilabad","publisher":"Vikipediya (azərbaycanca)","url":"https://az.wikipedia.org/w/index.php?title=C%C9%99lilabad&oldid=8674215","pageUrl":"https://az.wikipedia.org/wiki/C%C9%99lilabad","revid":8674215,"revDate":"2026-03-11","licence":"CC BY-SA 4.0","retrieved":"2026-11-26"},{"id":"wp-ru","kind":"wikipedia","lang":"ru","title":"Джалильабад","publisher":"Википедия (на русском